API_PREFIX=/api
APP_NAME=Svakosh API
APP_VERSION=0.1.0

# development | production
API_ENV=development
# comma-separated exact origins, no trailing slash, no wildcard
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

HOST=0.0.0.0
PORT=8000

# Consumed by docker-compose.yml to provision mongod/redis auth.
# openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | cut -c1-40
# Alphanumeric only — / + = @ : would need percent-encoding in the URIs below.
MONGO_ROOT_USER=svakosh_root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=svakosh_app
MONGO_APP_PASSWORD=
REDIS_PASSWORD=

MONGODB_DB_NAME=svakosh
# in compose  -> mongodb:27017 / redis:6379    (container ports)
# host / VM   -> localhost:37017 / :36379      (published ports)
# authSource=svakosh: the app user lives in the svakosh db, not admin
MONGODB_URI=mongodb://svakosh_app:<MONGO_APP_PASSWORD>@localhost:37017/svakosh?authSource=svakosh
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:36379/0

# openssl rand -hex 32  (use a different set per environment)
JWT_SECRET=
OTP_HMAC_SECRET=

# python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Rotating this makes existing ciphertext undecryptable.
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=

# RP_ID is the FRONTEND's domain, not the API's. prod: svakosh.vercel.app
WEBAUTHN_RP_NAME=Svakosh
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
# Cross-site frontend/API needs none + true. SAMESITE=none requires SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

APP_NAME=Svakosh API
APP_VERSION=0.1.0
API_PREFIX=/api
API_ENV=development
HOST=0.0.0.0
PORT=8000

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=svakosh
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173

# openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# openssl rand -hex 32
OTP_HMAC_SECRET=
OTP_LOCKOUT_FAIL_THRESHOLD=5
OTP_LOCKOUT_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=30

# python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_ISSUERS=https://accounts.google.com,accounts.google.com

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Svakosh
WEBAUTHN_ORIGIN=http://localhost:5173

COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
ACCESS_COOKIE_NAME=svakosh_access_token
REFRESH_COOKIE_NAME=svakosh_refresh_token
CSRF_COOKIE_NAME=svakosh_csrf
CSRF_HEADER_NAME=x-csrf-token

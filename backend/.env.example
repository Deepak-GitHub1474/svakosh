API_PREFIX=/api
APP_NAME=Svakosh API
APP_VERSION=0.1.0

API_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

HOST=0.0.0.0
PORT=8000

MONGO_ROOT_USER=svakosh_root
MONGO_ROOT_PASSWORD=
MONGO_APP_USER=svakosh_app
MONGO_APP_PASSWORD=
REDIS_PASSWORD=

MONGODB_DB_NAME=svakosh
MONGODB_URI=mongodb://svakosh_app:<MONGO_APP_PASSWORD>@localhost:37017/svakosh?authSource=svakosh
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:36379/0

# openssl rand -hex 32
JWT_SECRET=
OTP_HMAC_SECRET=

# python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=

WEBAUTHN_RP_NAME=Svakosh
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
